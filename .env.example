# ============================================================
# .env.example — Copy to .env and fill in your real values
# NEVER commit .env to version control
# ============================================================

# ── TRADING MODE ──────────────────────────────────────────
# PAPER = simulated (default), LIVE = real money
TRADING_MODE=PAPER

# ── CAPITAL ───────────────────────────────────────────────
PAPER_CAPITAL=10000.0         # Virtual balance for paper trading
LIVE_CAPITAL_LIMIT=0.0        # Max allowed capital for live (0 = disabled)

# ── RISK PARAMETERS ───────────────────────────────────────
RISK_PER_TRADE_PCT=1.0        # % of balance risked per trade
MAX_DAILY_DRAWDOWN_PCT=2.0    # Kill-switch: auto-stop if DD exceeds this
MAX_CONSECUTIVE_LOSSES=3      # Kill-switch: auto-stop after N losses
PROFIT_TRANSFER_TRIGGER_PCT=5.0  # Trigger banking transfer when profit > X%

# ── OANDA BROKER ──────────────────────────────────────────
OANDA_API_KEY=your_oanda_api_key_here
OANDA_ACCOUNT_ID=your_oanda_account_id_here
OANDA_ENVIRONMENT=practice    # practice | live

# ── INTERACTIVE BROKERS (optional) ────────────────────────
IB_HOST=127.0.0.1
IB_PORT=7497
IB_CLIENT_ID=1

# ── MT5 BRIDGE (optional, Windows only) ───────────────────
MT5_LOGIN=0
MT5_PASSWORD=your_mt5_password
MT5_SERVER=your_broker_server

# ── OLLAMA ────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT=120            # seconds
OLLAMA_MODEL_ORCHESTRATOR=llama3.1:8b
OLLAMA_MODEL_FUNDAMENTAL=mistral:7b
OLLAMA_MODEL_RISK=phi3:medium
OLLAMA_MODEL_CRITIC=llama3.1:8b
OLLAMA_MODEL_TECHNICAL=phi3:medium  # optional — technical uses pure Python by default

# ── DATABASE ──────────────────────────────────────────────
DATABASE_PATH=./trading_system.db
DB_BACKUP_INTERVAL_HOURS=6

# ── TELEGRAM ALERTS (optional) ────────────────────────────
TELEGRAM_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
TELEGRAM_ENABLED=false

# ── LOGGING ───────────────────────────────────────────────
LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR
LOG_DIR=./logs

# ── BROKER SELECTION ──────────────────────────────────────
ACTIVE_BROKER=oanda           # oanda | ib | mt5 | paper

# ── TRADING PARAMETERS ────────────────────────────────────
TRADING_SYMBOL=EUR_USD
TRADING_INTERVAL_MINUTES=15   # Cycle frequency
MIN_CONFIDENCE_THRESHOLD=0.65 # Orchestrator min confidence to trade

# ── API Server ────────────────────────────────────────────
API_ENABLED=true
API_HOST=0.0.0.0
API_PORT=8080

# ── Operator Token (REQUIRED for kill-switch reset via API) ──
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
# Without this set, POST /api/system/kill-switch/reset returns 503.
OPERATOR_TOKEN=

# ── Trading cycle timing ──────────────────────────────────
CYCLE_INTERVAL_SECONDS=300
CYCLE_TIMEOUT_SECONDS=300

# ── Backtesting defaults ──────────────────────────────────
BACKTEST_DEFAULT_START=2024-01-01
BACKTEST_DEFAULT_END=2024-12-31

# ============================================================
# COMMERCIAL LICENSE (required for LIVE mode)
# ============================================================
# Obtain from gustavolobatoclara@gmail.com
COMMERCIAL_LICENSE_KEY=

# ── Royalty Settings ──────────────────────────────────────
# 10% of NET PROFIT on winning trades is paid to author wallets.
# PAPER mode logs the obligation but transfers nothing.
ROYALTY_PREFERRED_CHAIN=polygon
# Your wallet (LIVE only) — used to SIGN the royalty transfer:
ROYALTY_USER_PRIV_KEY=
ROYALTY_USER_ADDRESS=
# FX rate from account currency (USD) to native token of the chain.
# Example: 1 USD ≈ 1.25 MATIC → ROYALTY_NATIVE_PER_USD_POLYGON=1.25
ROYALTY_NATIVE_PER_USD_POLYGON=
ROYALTY_NATIVE_PER_USD_ETHEREUM=
ROYALTY_NATIVE_PER_USD_BNB=
ROYALTY_NATIVE_PER_USD_BASE=
ROYALTY_NATIVE_PER_USD_LINEA=

# Optional RPC overrides
ROYALTY_POLYGON_RPC=
ROYALTY_ETHEREUM_RPC=

# ============================================================
# NEW AGENTS (toggle on/off)
# ============================================================
ENABLE_ORDER_FLOW_AGENT=true
ENABLE_STAT_ARB_AGENT=true
ENABLE_ML_AGENT=true
ENABLE_SOCIAL_AGENT=true
ENABLE_INTERMARKET_AGENT=true

# ── Social Sentiment (X / Reddit) ─────────────────────────
X_BEARER_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=multiagent-fx/1.0
